#!/bin/sh
# harness — one todo, one branch, one worktree; trunk merged by one integrator.
#
# Resolves a verb to harness/verbs/<verb>.sh and sources it. There is no verb
# registry on purpose: adding a verb adds a file and edits nothing, so two
# branches adding verbs never conflict.

set -eu

HARNESS_HOME=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
readonly HARNESS_HOME

# shellcheck source=/dev/null  # a glob cannot be followed statically
for _lib in "$HARNESS_HOME"/lib/*.sh; do . "$_lib"; done
unset _lib

HARNESS_REPO=$(git rev-parse --show-toplevel 2>/dev/null) ||
	die "$EX_FAIL" "not inside a git repository"
readonly HARNESS_REPO

# Each worktree runs its own copy. Invoking one worktree's harness against
# another's checkout would read the wrong .harness.conf and act on the wrong
# tree, so it is refused rather than guessed at.
if [ "$HARNESS_HOME" != "$HARNESS_REPO/harness" ]; then
	die "$EX_FAIL" "$0 belongs to $(dirname -- "$HARNESS_HOME"), but the current tree is $HARNESS_REPO
  use that tree's own copy:  harness() { \"\$(git rev-parse --show-toplevel)/harness/bin/harness\" \"\$@\"; }"
fi

[ -f "$HARNESS_REPO/.harness.conf" ] ||
	die "$EX_FAIL" "no .harness.conf in $HARNESS_REPO — run harness/install.sh"
# shellcheck source=/dev/null  # per-project, by design
. "$HARNESS_REPO/.harness.conf"

: "${HARNESS_PROJECT:?.harness.conf must set HARNESS_PROJECT}"
: "${HARNESS_TRUNK:?.harness.conf must set HARNESS_TRUNK}"
: "${HARNESS_WORKTREE_ROOT:?.harness.conf must set HARNESS_WORKTREE_ROOT}"

verb=help
if [ $# -gt 0 ]; then
	verb=$1
	shift
fi
case $verb in
-h | --help) verb=help ;;
esac

verb_file="$HARNESS_HOME/verbs/$verb.sh"
[ -f "$verb_file" ] || die "$EX_USAGE" "unknown verb: $verb (try: harness help)"

# shellcheck source=/dev/null  # the verb is resolved at runtime
. "$verb_file"
